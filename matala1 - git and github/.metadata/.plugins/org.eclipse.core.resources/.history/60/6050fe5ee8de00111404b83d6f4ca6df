

package avoda1;


public class Enemy extends Character {
	private int damage;

	public Enemy(String name, int health, int level, int damage) {
		super(name, health, level);
		this.damage = damage;
	}
	
	public int getDamage(){
		return damage;
	}
	
	public String toString() {
		return super.toString()
			Damage + damage"/n";
	}
	
}
